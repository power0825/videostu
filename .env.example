# ---------------------------------------------------------------------------
# Copy this file to .env.local for `vercel dev`, and set the same names in the
# Vercel project settings for the deployed version. Never commit real keys.
# ---------------------------------------------------------------------------

# A single code the whole class shares. Whoever opens the link has to type it once.
# It is not a login and it does not identify anyone — its only job is to stop
# strangers from spending your model credits. Set it before the link goes public.
ACCESS_CODE=

# Volcengine Ark. The text model plans the shots, the image model draws the keyframes.
VOLCENGINE_API_KEY=
VOLCENGINE_TEXT_MODEL=
VOLCENGINE_IMAGE_MODEL=

# Bailian (DashScope). Turns a keyframe into a moving clip.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_VIDEO_MODEL=wan3.0-video

# Blob storage for keyframes, clips and the finished film.
# Created automatically when you add a Blob store to the Vercel project — you do
# not paste this one by hand, Vercel injects it.
BLOB_READ_WRITE_TOKEN=

# Burned-in captions.
# IMPORTANT: the Linux runtime has almost no fonts installed. Leave this pointing at
# the bundled font, or drop your own .ttf into ./fonts and name it here.
# A name that does not exist renders every caption as empty boxes.
CAPTION_FONT=DejaVu Sans
CAPTION_SIZE=44
