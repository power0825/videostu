# ---------------------------------------------------------------------------
# Copy this file to .env.local for `vercel dev`, and set the same names in the
# Vercel project settings for the deployed version. Never commit real keys.
# ---------------------------------------------------------------------------

# The class code. YOU invent it — nothing generates it — then paste it here and into the Vercel
# project settings. Every student types the same value once, on their first visit.
#
# Rules of thumb:
#   - If this is left EMPTY the door has no lock: the studio opens without asking, and anyone who
#     finds the URL can spend your model credits.
#   - If it is set, the page asks for it and rejects everything else.
#   - Use something not worth guessing but easy to read out loud, e.g. everknit-pique-2026.
#   - Changing it later locks out everyone who already entered the old one; they just re-enter.
#   - Store this one as CONFIG, not Secret. A Secret cannot be read back by anyone once saved, so a
#     forgotten class code means deleting the variable and starting again. Config keeps it readable.
ACCESS_CODE=

# Volcengine Ark. The text model plans the shots, the image model draws the keyframes.
VOLCENGINE_API_KEY=
VOLCENGINE_TEXT_MODEL=
VOLCENGINE_IMAGE_MODEL=

# Bailian (DashScope). Turns a keyframe into a moving clip.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
BAILIAN_VIDEO_MODEL=wan3.0-video

# Blob storage for keyframes, clips and the finished film.
# Created automatically when you add a Blob store to the Vercel project — you do
# not paste this one by hand, Vercel injects it.
BLOB_READ_WRITE_TOKEN=

# Burned-in captions.
# IMPORTANT: the Linux runtime has almost no fonts installed. Leave this pointing at
# the bundled font, or drop your own .ttf into ./fonts and name it here.
# A name that does not exist renders every caption as empty boxes.
CAPTION_FONT=DejaVu Sans
CAPTION_SIZE=44
